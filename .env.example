# PostgreSQL connection string. Put your own password here — never in this file.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/dispatchsim

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# At least 32 characters. Never commit the real value.
JWT_SECRET=

JWT_EXPIRES_IN=24h
PORT=4000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Optional. One of: dispatcher, hr, finance, fleet-manager. Left blank
# (the default), every newly registered account starts with no roles
# granted at all (an empty `roles` set, `activeRole: null`) until an
# administrator grants one via PATCH /admin/users/:id, or the student
# registers through an invite link. Set this only if this deployment wants
# every new signup that did NOT use an invite code to be granted that one
# role automatically (added to `user_roles`, not written to a single
# `role` column — there no longer is one; see migration 003). An invite
# code's own roles always take priority over this when both apply.
DEFAULT_ROLE=

# --- AI seed generator (scripts/generate-seed.js) -------------------------
# Any OpenAI-compatible chat/completions endpoint works: Groq, OpenRouter,
# Together, Gemini's OpenAI-compat endpoint, a local Ollama. Not required to
# run the app itself -- only to run `npm run generate:seed` for real (the
# --dry-run flag needs none of this).
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile

# Requests per minute the seed generator will stay under. Batches run
# strictly sequentially, spaced out from this value -- never in parallel.
AI_MAX_RPM=25

# PostgreSQL connection string. Put your own password here — never in this file.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/dispatchsim

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# At least 32 characters. Never commit the real value.
JWT_SECRET=

JWT_EXPIRES_IN=24h
PORT=4000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Optional. One of: dispatcher, hr, finance, fleet-manager. Left blank
# (the default), every newly registered account starts with no roles
# granted at all (an empty `roles` set, `activeRole: null`) until an
# administrator grants one via PATCH /admin/users/:id, or the student
# registers through an invite link. Set this only if this deployment wants
# every new signup that did NOT use an invite code to be granted that one
# role automatically (added to `user_roles`, not written to a single
# `role` column — there no longer is one; see migration 003). An invite
# code's own roles always take priority over this when both apply.
DEFAULT_ROLE=

# The money model: 'on' (the default, also what a blank means) or 'off'.
#
# Off, three things stop: credit-line interest, the fleet insurance
# premium, and every refusal that comes from the balance -- the lender
# declining a booking, a hire or a truck. The balance also leaves the top
# bar, because a number that no longer has a consequence attached should
# not be sitting next to the button that spends it.
#
# Nothing is deleted and nothing is reset. The ledger keeps recording what
# is spent and collected; switching it back on resumes against the account
# as it stands. Anything other than 'on' or 'off' is a startup error, so a
# typo cannot disable the money model quietly.
FINANCE=on

# --- AI seed generator (scripts/generate-seed.js) -------------------------
# Any OpenAI-compatible chat/completions endpoint works: Groq, OpenRouter,
# Together, Gemini's OpenAI-compat endpoint, a local Ollama. Not required to
# run the app itself -- only to run `npm run generate:seed` for real (the
# --dry-run flag needs none of this).
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=<your-groq-api-key>
AI_MODEL=llama-3.3-70b-versatile

# Requests per minute the seed generator will stay under. Batches run
# strictly sequentially, spaced out from this value -- never in parallel.
AI_MAX_RPM=25

# --- Chat replies (brokers and drivers) ---------------------------------
# Fast replies: every broker and driver answer inside one minute, end to
# end. For a day of live testing only -- the normal waits (an A broker in
# under a minute, a C broker in a few, a driver behind the wheel at the
# next stop) are what the job is. The waits are squeezed, not cut, so a
# quick broker is still quicker than a slow one. Blank or 'off' = normal.
# Anything else stops the app. Takes effect on restart of the API and bot.
CHAT_FAST_REPLIES=

# Requests a day the provider REALLY allows this account. Blank = the
# provider's published number (OpenRouter free models: 50). Set 1000 only
# after $10 of OpenRouter credit has been bought -- the app cannot see the
# purchase, and a number above the truth only trades the app's clear
# "used up" message for the provider's 429. 10% is still kept back.
CHAT_REQUESTS_PER_DAY=

# Room for one reply, in tokens, including a reasoning model's thinking.
# Blank = 880 (a 220-token reply plus three times that to think). Raise
# it only for a reasoning model that runs out of room mid-thought.
CHAT_MAX_TOKENS=

# Thinking before the reply. Blank/on = capped thinking (for reasoning
# models, which cannot answer without it). off = no thinking at all
# (reasoning.effort "none") -- for a chat model whose reasoning is
# optional, e.g. google/gemma-4-31b-it:free. A cap is NOT neutral for such
# a model: OpenRouter reads it as "turn thinking on".
CHAT_REASONING=

# --- Telegram (driver chat in a group) ----------------------------------
# The bot runs in THIS project: `npm run bot`, beside `npm start`. It was
# a separate process with its own .env until 2026-09-29; it needed this
# project's database and model client, and an HTTP hop between them was
# one moving part more than the job has.
#
# All three or none. All three blank = no bot, and the app runs exactly
# as it did before it existed.
#
#   TOKEN       BotFather -> /newbot (or /token). Privacy mode must be
#               OFF (/setprivacy -> Disable), or the bot sits in the
#               group and never sees an ordinary message.
#   CHAT_ID     the group. Negative for a group/supergroup. Add the bot,
#               send any message, then read the id from the bot's log.
#   DISPATCHER  which account's threads the group is. The same
#               conversations the app's Driver chat shows.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DISPATCHER_EMAIL=

# May the driver model LOOK at an incoming photo? Off by default: with it
# off the bot says plainly that the model cannot see pictures and still
# delivers the caption. The model named in CHAT_DRIVER_MODEL has to be a
# vision model for 'on' to mean anything.
CHAT_DRIVER_VISION=off

# One fixed driver for the whole group (optional). Set: every message
# that does not name a recipient goes to this driver -- no /d, no roster
# question. Blank: the group picks with /d or is asked who it means.
TELEGRAM_DRIVER_NAME=

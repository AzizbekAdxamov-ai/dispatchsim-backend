# PostgreSQL connection string. Put your own password here — never in this file.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/dispatchsim

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# At least 32 characters. Never commit the real value.
JWT_SECRET=

JWT_EXPIRES_IN=24h
PORT=4000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Optional. One of: dispatcher, hr, finance, fleet-manager. Left blank
# (the default), every newly registered account starts with no roles
# granted at all (an empty `roles` set, `activeRole: null`) until an
# administrator grants one via PATCH /admin/users/:id, or the student
# registers through an invite link. Set this only if this deployment wants
# every new signup that did NOT use an invite code to be granted that one
# role automatically (added to `user_roles`, not written to a single
# `role` column — there no longer is one; see migration 003). An invite
# code's own roles always take priority over this when both apply.
DEFAULT_ROLE=

# The money model: 'on' (the default, also what a blank means) or 'off'.
#
# Off, three things stop: credit-line interest, the fleet insurance
# premium, and every refusal that comes from the balance -- the lender
# declining a booking, a hire or a truck. The balance also leaves the top
# bar, because a number that no longer has a consequence attached should
# not be sitting next to the button that spends it.
#
# Nothing is deleted and nothing is reset. The ledger keeps recording what
# is spent and collected; switching it back on resumes against the account
# as it stands. Anything other than 'on' or 'off' is a startup error, so a
# typo cannot disable the money model quietly.
FINANCE=on

# --- AI seed generator (scripts/generate-seed.js) -------------------------
# Any OpenAI-compatible chat/completions endpoint works: Groq, OpenRouter,
# Together, Gemini's OpenAI-compat endpoint, a local Ollama. Not required to
# run the app itself -- only to run `npm run generate:seed` for real (the
# --dry-run flag needs none of this).
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=<your-groq-api-key>
AI_MODEL=llama-3.3-70b-versatile

# Requests per minute the seed generator will stay under. Batches run
# strictly sequentially, spaced out from this value -- never in parallel.
AI_MAX_RPM=25

# --- Telegram bridge (haydovchi suhbati Telegramda) ------------------------
# Bot tokenini @BotFather beradi. Bo'sh bo'lsa modul umuman ishga tushmaydi
# va ilova oldingidek ishlaydi. Token FAQAT shu faylda: kodga, logga,
# testga, commitga yozilmaydi.
TELEGRAM_BOT_TOKEN=

# 'poll' (lokal dev, bot o'zi so'raydi) yoki 'webhook' (serverless). Boshqa
# qiymat — start xatosi, typo botni jim o'ldirmasin.
TELEGRAM_MODE=poll

# Ixtiyoriy qulf: vergula bilan chat id ro'yxati (guruh id manfiy bo'ladi).
# Bo'sh — bot istalgan chatga javob beradi.
TELEGRAM_ALLOWED_CHAT_IDS=

# Haydovchi modeli kiruvchi rasmni ko'radimi. off bo'lsa bot halol javob
# beradi: "rasm keldi, lekin model rasmni ko'rmaydi" va matnni uzatadi.
CHAT_DRIVER_VISION=off
